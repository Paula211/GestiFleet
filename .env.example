# Variables de entorno que lee la aplicación.
#
# El proyecto NO usa dotenv, así que un fichero .env no se carga solo.
# Tienes dos opciones:
#   1. Exportarlas en tu shell antes de arrancar:
#        export DB_PORT=3306 && npm run dev
#   2. Instalar dotenv (npm i dotenv) y añadir al principio de app.js:
#        require('dotenv').config();
#
# Si no defines ninguna, se usan los valores por defecto que aparecen aquí,
# que son los de un MySQL local. El proyecto arranca sin configurar nada.

# Puerto del servidor Express
PORT=3000

# Conexión a MySQL (data/db.js)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=gestifleetbd
